{
  "name": "chess-llama",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "chess-llama": "./chess-llama",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p llama/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run && pnpm test:shell",
    "test:shell": "pnpm --filter @chess-llama/operations... build && bats tests/shell",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:shell": "docker run --rm -v \"$PWD:/mnt\" -w /mnt koalaman/shellcheck@sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d chess-llama scripts/cli/*.sh tests/shell/*.bash tests/shell/*.bats",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:shell:check": "docker run --rm -v \"$PWD:/mnt\" -w /mnt mvdan/shfmt@sha256:f22f3936140be1ba02d493b5d2b91d0e8b4af93fd903e7f46c477822bca4a3be -d -i 2 -ci chess-llama scripts/cli tests/shell",
    "notices": "node --import tsx scripts/generate-third-party-notices.mts"
  },
  "devDependencies": {
    "@bats-core/bats": "https://github.com/bats-core/bats-core/archive/refs/tags/v1.14.0.tar.gz",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "execa": "^9.6.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.5"
  }
}
